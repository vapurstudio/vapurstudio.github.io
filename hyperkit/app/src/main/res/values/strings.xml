<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">HyperKit</string>
    <string name="app_tagline">Customization toolkit for HyperOS. No root needed.</string>
    <string name="service_label">HyperKit gestures &amp; keys</string>
    <string name="service_summary">Edge gestures, volume key actions, keep screen on</string>
    <string name="service_description">HyperKit uses this service only to: draw the edge gesture handles you configure, perform system actions you choose (back, home, recents, lock screen, screenshot…), keep the screen on when Caffeine is enabled and react to volume key presses for Sound Assistant. It does not read screen content and no data leaves your device.</string>

    <!-- setup -->
    <string name="setup_body">Edge Gestures, Sound Assistant and several tiles need the accessibility service. On HyperOS: Settings → Additional settings → Accessibility → Downloaded apps → HyperKit.</string>
    <string name="setup_open">Open accessibility settings</string>
    <string name="setup_autostart">HyperOS tip: allow Autostart and set Battery saver to “No restrictions” for HyperKit, and lock it in Recents, so the system does not stop the service.</string>
    <string name="setup_autostart_btn">Autostart settings</string>
    <string name="service_on">Service running</string>
    <string name="service_off">Service off</string>

    <!-- modules -->
    <string name="mod_edge">Edge Gestures</string>
    <string name="mod_edge_desc">Swipe from the screen edges for back, home, recents, screenshot and more.</string>
    <string name="mod_sound">Sound Assistant</string>
    <string name="mod_sound_desc">Volume keys control media, long-press to skip tracks, all volumes in one place.</string>
    <string name="mod_tiles">Quick Tiles</string>
    <string name="mod_tiles_desc">Extra Control Center tiles: Caffeine, lock, screenshot, power menu, animations.</string>
    <string name="mod_hidden">Hidden Settings</string>
    <string name="mod_hidden_desc">Open hidden Android and HyperOS screens and pin them to the home screen.</string>
    <string name="mod_tuner">System Tuner</string>
    <string name="mod_tuner_desc">Animation speed, status bar icons, screen timeout and font size.</string>
    <string name="needs_service">Needs the HyperKit service</string>

